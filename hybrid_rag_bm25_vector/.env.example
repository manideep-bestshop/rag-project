# Copy this file to .env and adjust if your local setup differs.

# --- Document loading (shared corpus with ../chunk_embd_vctor_db) ---
CORPUS_DIR=/Users/srinivaskotipalli/mai-practitioner/RAG/chunk_embd_vctor_db/aventro/pdf
MAX_PDF_FILES=5

# --- Chunking ---
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# --- Dense embeddings (local Ollama) ---
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768

# --- Local LLM used by ask.py for the final answer step ---
LLM_MODEL=llama3.2

# --- Postgres + pgvector (dense/vector store -- separate db from the
# sibling project so the two never collide) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=aventro_hybrid_rag_db
TABLE_NAME=hybrid_document_chunks

# --- BM25 sparse/keyword store (new -- local pickle file, no server) ---
BM25_INDEX_PATH=./bm25_store/bm25_index.pkl
BM25_K1=1.5
BM25_B=0.75

# --- Hybrid retrieval + fusion ---
TOP_K_DENSE=10
TOP_K_SPARSE=10
TOP_K_FINAL=4
FUSION_METHOD=rrf
RRF_K=60
DENSE_WEIGHT=0.5
SPARSE_WEIGHT=0.5
